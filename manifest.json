{
  "manifest_version": 3,
  "name": "Pause YouTube Shorts",
  "version": "1.0",
  "description": "끝없는 쇼츠 스크롤 굴레에서 벗어나세요.",
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
